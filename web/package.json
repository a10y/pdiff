{
  "name": "pdiff-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run build:classic && ./build-hub.sh",
    "build:classic": "bun build src/main.ts --outdir dist --target browser --minify --format esm && cp src/index.html src/style.css dist/",
    "typecheck": "tsc -p hub/tsconfig.json"
  },
  "dependencies": {
    "@pierre/diffs": "^1.6.4",
    "@pierre/highlights": "0.4.0",
    "@pierre/icons": "0.9.0",
    "@pierre/theme": "2.0.0",
    "@pierre/theming": "1.0.2",
    "@pierre/trees": "1.0.0",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-switch": "1.2.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.545.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sonner": "2.0.7",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.1.13",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.1.13",
    "tw-animate-css": "1.4.0",
    "typescript": "^7.0.2"
